        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type, outcome) (rate(tgbot_updates_total[5m]))",
          "legendFormat": "{{event_type}} {{outcome}}"
        }
      ]
    },
