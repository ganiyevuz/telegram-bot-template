# Telegram Bot Settings
BOT_TOKEN="110201544:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw"
SUPPORT_URL="https://example.com/"
RATE_LIMIT=0.5  # min seconds between messages allowed per user; 0 or negative disables inbound throttling
DEBUG=False
# Webhook Server Settings (Optional) — only honored by `bot.entrypoints.api`;
# `bot.entrypoints.polling` refuses to start while USE_WEBHOOK=True
USE_WEBHOOK=False
WEBHOOK_HOST="0.0.0.0"  # use "localhost" if not using Docker
# HOST port only. The container always serves on 8080 (see the Dockerfile CMD); compose
# maps ${WEBHOOK_PORT}:8080. Change it to dodge a host port collision — nothing inside
# the container reads it.
WEBHOOK_PORT=8080
WEBHOOK_BASE_URL="https://example.com"
WEBHOOK_PATH="/webhook"
WEBHOOK_SECRET="Pl7U9AJUFb2"
WEBHOOK_VERIFY_SOURCE_IP=True   # set False when a proxy rewrites the source address
WEBHOOK_TRUST_PROXY_HEADERS=False   # only set True when a proxy YOU control appends to
                                     # X-Forwarded-For — it is attacker-controlled otherwise
                                     # and enabling this without such a proxy defeats WEBHOOK_VERIFY_SOURCE_IP

# Payment Settings — Telegram Stars only. XTR needs no provider token, and this
# template implements no fiat provider; see bot/handlers/payments.py for what
# switching PAYMENT_CURRENCY to real money would actually require.
PAYMENT_CURRENCY="XTR"
PAYMENT_PREMIUM_PRICE=100
PAYMENT_SUBSCRIPTION_PERIOD_DAYS=30

# Mini App Settings
WEBAPP_URL=""   # public HTTPS URL of the Mini App page (this app serves it at /webapp).
                # Telegram WILL NOT load a Mini App over plain HTTP, and "localhost" points
                # at the phone itself on mobile clients — expose it through a tunnel
                # (cloudflared, ngrok, ...) for local testing. Leave empty to drop the
                # launch button from the menu; an empty web_app URL is rejected by Telegram
                # and kills the entire keyboard, not just that button.
WEBAPP_INIT_DATA_MAX_AGE=3600   # seconds a captured initData stays usable. It is a bearer
                                # credential — replay within the window is by design — so this
                                # bounds how long a leaked one can call /api/webapp/* as that
                                # user. The Telegram client refreshes initData by itself, so
                                # raising this buys nothing but exposure.

# Admin Panel Settings — the panel is part of the api service now, served at
# ${WEBHOOK_PORT}/admin. There is no separate admin container and no ADMIN_PORT.
ADMIN_ENABLED=True
# REQUIRED while ADMIN_ENABLED=True, and deliberately blank here: this key signs the
# admin session cookie, so a value shipped in the template would let anyone who has read
# it forge a logged-in admin session on every deployment that kept the default. The app
# refuses to start with an empty one. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=
# Seeded once, on the first start against a database with an empty admin table. Change
# the password here AND on the seeded account — a deployment left on "admin" is warned
# about in the log on every boot.
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="admin"

# Database Settings
DB_HOST="pgbouncer"     # use "localhost" if not using Docker
# KEEP 5432. This is the port the app DIALS at `pgbouncer:5432` inside the compose
# network — a container port, not a host one. Compose publishes it as ${DB_PORT}:5432,
# so changing it to dodge a host collision points the app at a port nothing listens on,
# and the stack fails in a way that reads as a database outage. Edit the LEFT side of
# that mapping in docker-compose.yml instead.
DB_PORT=5432
DB_USER="tgbot"
DB_PASS="OGU6P2TNUEwxekD0OHe7"
DB_NAME="bot_db"
# Per-replica SQLAlchemy pool. These multiply by replica count, so the ceiling that
# matters is pgbouncer's MAX_DB_CONNECTIONS (50) in docker-compose.yml, not these —
# see the pgbouncer transaction-pooling note in README. Defaults shown.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Redis (for FSM and Cache) Settings
REDIS_HOST="redis"      # use "localhost" if not using Docker
# KEEP 6379. Same as DB_PORT: this is what the app dials at `redis:6379` inside the
# compose network, not the host binding.
REDIS_PORT=6379
REDIS_DB=0        # logical database index; separate deployments sharing one Redis should differ
REDIS_PASS=

# For Docker Compose file
COMPOSE_PROJECT_NAME=tgbot

# External Services Settings (API Keys for example)
SENTRY_DSN=""
AMPLITUDE_API_KEY=""
POSTHOG_API_KEY=""

# Performance Monitoring System Settings
# HOST port only; the container side is pinned to 9090
PROMETHEUS_PORT=9090
# HOST port only; the container side is pinned to 3000
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"

# Logging / analytics tuning (optional)
LOG_LEVEL="INFO"
ANALYTICS_FLUSH_INTERVAL=30

# Operational Alerting Settings — pushes alerts (errors, suppression summaries, ...) into
# a Telegram chat you control.
NOTIFIER_CHAT_ID=   # off switch: empty/unset means the notifier is a silent no-op.
                     # Set to a chat id (a group, channel, or your own DM with the bot)
                     # to start receiving alerts.
NOTIFIER_TOPIC_ID=  # optional forum thread (message_thread_id) within NOTIFIER_CHAT_ID
NOTIFIER_SECRET=    # HMAC key authenticating POST /api/notify. Deliberately blank here:
                     # unlike ADMIN_SECRET_KEY this does NOT fall back to "unauthenticated" —
                     # an empty value disables the endpoint outright. Generate your own:
                     #   python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTIFIER_COOLDOWN_SECONDS=300  # min seconds between two alerts sharing the same
                                # fingerprint; repeats within the window are counted and
                                # rolled into the next delivered alert's "suppressed" tail

# Encrypted Backup Settings (Backupgram) — ships the dumps `pgbackup` already writes to
# the backups-data volume into a private Telegram channel, encrypted. Nothing here dumps
# the database; the worker mounts that volume read-only and uploads what it finds.
BACKUP_AGE_PUBLIC_KEY=   # REQUIRED to enable backups, and deliberately blank: a key shipped
                         # with the template would have every deployment encrypt to the same
                         # recipient, which is the same as not encrypting. Generate a keypair
                         # OFF this machine:
                         #   age-keygen -o backup-key.txt   # prints "Public key: age1..."
                         # Put ONLY the age1... public key here. ESCROW THE PRIVATE KEY
                         # OFFLINE (password manager, printed copy in a safe, ...): the
                         # deployment never holds it, so an attacker who takes the bot, the
                         # container or the Telegram account gets ciphertext — and LOSING IT
                         # MAKES EVERY BACKUP UNREADABLE BY ANYONE, INCLUDING YOU.
BACKUP_CHAT_ID=          # private channel/group the encrypted artifacts are sent to; the bot
                         # must be an admin there. Empty/unset switches the feature off.
                         # Grant it can_delete_messages too, or the retention sweep below
                         # only ever manages to delete backups under 48 hours old.
BACKUP_SCHEDULE="0 3 * * *"   # crontab syntax; when the scheduler enqueues the upload. Read
                         # from here at import, so it genuinely takes effect — but it must be
                         # 5 space-separated fields ("@daily" and friends are not crontab):
                         # anything else logs an error and falls back to this default.
BACKUP_DIR="/backups"    # where pgbackup's dumps are mounted READ-ONLY inside the worker
                         # container. Matches the `backups-data:/backups:ro` mount in
                         # docker-compose.yml — change both together or neither.
BACKUP_KEEP_DAYS=30      # retention: `backup:prune` deletes backup messages this bot itself
                         # uploaded once they are older than this. It only ever deletes the
                         # message ids it recorded in Redis — the channel is never scanned,
                         # so anything else you keep in there is left alone.
